@prefix sbol: <http://sbols.org/v2#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://ex/device/1> a sbol:ComponentDefinition ;
    sbol:displayId "device" ;
    sbol:persistentIdentity <http://ex/device> ;
    sbol:version "1" ;
    dcterms:title "device" ;
    sbol:type <http://www.biopax.org/release/biopax-level3.owl#DnaRegion> ;
    sbol:role <http://identifiers.org/so/SO:0000804> ;
    sbol:sequence <http://ex/device_seq/1> ;
    sbol:component <http://ex/device/promoter/1> ;
    sbol:sequenceAnnotation <http://ex/device/promoter_anno/1> .

<http://ex/device/promoter/1> a sbol:Component ;
    sbol:displayId "promoter" ;
    sbol:persistentIdentity <http://ex/device/promoter> ;
    sbol:version "1" ;
    sbol:definition <http://ex/promoter/1> ;
    sbol:access sbol:public .

<http://ex/device/promoter_anno/1> a sbol:SequenceAnnotation ;
    sbol:displayId "promoter_anno" ;
    sbol:persistentIdentity <http://ex/device/promoter_anno> ;
    sbol:version "1" ;
    sbol:component <http://ex/device/promoter/1> ;
    sbol:location <http://ex/device/promoter_anno/range/1> .

<http://ex/device/promoter_anno/range/1> a sbol:Range ;
    sbol:displayId "range" ;
    sbol:persistentIdentity <http://ex/device/promoter_anno/range> ;
    sbol:version "1" ;
    sbol:start 1 ;
    sbol:end 4 ;
    sbol:orientation sbol:inline .

<http://ex/promoter/1> a sbol:ComponentDefinition ;
    sbol:displayId "promoter" ;
    sbol:persistentIdentity <http://ex/promoter> ;
    sbol:version "1" ;
    sbol:type <http://www.biopax.org/release/biopax-level3.owl#DnaRegion> ;
    sbol:role <http://identifiers.org/so/SO:0000167> ;
    sbol:sequence <http://ex/promoter_seq/1> .

<http://ex/device_seq/1> a sbol:Sequence ;
    sbol:displayId "device_seq" ;
    sbol:persistentIdentity <http://ex/device_seq> ;
    sbol:version "1" ;
    sbol:elements "ttgacagctagc" ;
    sbol:encoding <http://www.chem.qmul.ac.uk/iubmb/misc/naseq.html> .

<http://ex/promoter_seq/1> a sbol:Sequence ;
    sbol:displayId "promoter_seq" ;
    sbol:persistentIdentity <http://ex/promoter_seq> ;
    sbol:version "1" ;
    sbol:elements "ttga" ;
    sbol:encoding <http://www.chem.qmul.ac.uk/iubmb/misc/naseq.html> .
